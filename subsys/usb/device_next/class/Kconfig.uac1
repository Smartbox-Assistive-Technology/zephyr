config USBD_AUDIO1_CLASS
	bool "USB Audio 1 class support"
	select UDC_ENABLE_SOF
	help
	  USB Audio 1 device class support for the device_next USB stack.

if USBD_AUDIO1_CLASS

module = USBD_UAC1
module-str = usbd uac1
source "subsys/logging/Kconfig.template.log_config"

endif
